# Winter ARC Pro — Commercial Website Configuration (.env.example)
# Public variables prefixed with VITE_ are bundled into client-side JS.
# NEVER put Razorpay Key Secret, JWT secret, or private signing keys in this file.

# Backend API Base URL (leave empty for same-origin or local proxy /api)
VITE_API_BASE_URL=http://localhost:8080

# Razorpay Public Key ID (Required for Razorpay Checkout Modal)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Google OAuth 2.0 Web Client ID (From Google Cloud Console Credentials)
# When omitted, the website automatically enables seamless local test/mock Google sign-in.
VITE_GOOGLE_CLIENT_ID=

# Windows Application Download URL (Points to public release or local static asset)
VITE_DOWNLOAD_URL=/downloads/Winter-ARC-Pro-1.0.1.msi

# GitHub Releases Page
VITE_GITHUB_RELEASE_URL=https://github.com/winterarc/winter-arc-desktop/releases

# Support Contact Email
VITE_CONTACT_EMAIL=support@winterarc.pro

# Application Version
VITE_APP_VERSION=1.0.1
