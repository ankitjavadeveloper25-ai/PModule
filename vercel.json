{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://springboot-igj8.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://springboot-igj8.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/(.*)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
